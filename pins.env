# Pinned inputs for JSpark3 v2.0.1 (GLM-5.3 Flash). Every script checks what it fetches or builds against these.
# Changing any line makes a different release: the published results were measured with exactly these inputs.

RELEASE=v2.0.1

# Engine: a fork of TensorFold 0.3.6.2 (MIT; github.com/ashhart/TensorFold), vendored in engine/ as a single source
# snapshot of this commit. MIT, including third-party code under its own permissive licenses
# (engine/THIRD_PARTY_NOTICES.md) and two lines ported from upstream TensorFold under Apache-2.0 (engine/NOTICE).
ENGINE_COMMIT=509bfa8f60b14f956f14a4c5a58973b3f119c545
ENGINE_WHEEL=tensorfold-0.3.6.2-py3-none-any.whl
# File-content digest of the wheel built from engine/ (scripts/wheel-content.py: sorted file hashes and paths,
# excluding only *.dist-info/RECORD and *.dist-info/WHEEL). build-wheel.sh and serve.sh refuse any other wheel.
# The published results were measured with this wheel: the release installed as INSTALL.md describes, which builds it
# from engine/. Before export, the engine's fix was tested with a wheel built straight from its source at the same
# commit (content digest 269f5515af6ba02a97c22dba5cce71a8740b2e647ae266fb49c1da41d56f379c). The two differ only in
# comments, docstrings, help and error text, links, license and notice files, package metadata, and the update command,
# which here only prints how to update. Serving never runs it: serve.sh passes --no-update-check and config/serve.env
# sets TENSORFOLD_NO_UPDATE_CHECK=1. Every native file is byte-identical.
WHEEL_CONTENT_SHA256=f90dc39330582009ce7bcc0a55c3b32a6e2102edfda2d05e2bb8a075b7dcf245

# Container: NVIDIA PyTorch 26.07 (multi-arch index digest). Pulled from NVIDIA NGC under NVIDIA's terms; never redistributed.
IMAGE=nvcr.io/nvidia/pytorch@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
# What `docker image inspect` reports as the image ID on arm64 (the config digest).
IMAGE_ID=sha256:15b8de8baabe68e46afc51e88f3ccad5042013bafe8f244ec082ce0bb06d47e3

# Base weights: MLX affine 4-bit (group 64) conversion of zai-org/GLM-5.3-Flash with its MTP head. MIT.
# First published as Vontra/GLM-5.3-Flash-MLX-4bit-MTP; that name now redirects here and the revision is unchanged.
BASE_REPO=TensorFold/GLM-5.3-Flash-MLX-4bit-MTP
BASE_REV=76add2a341a1cd90ad0e86bb69839ea9c35827c6

# The Hugging Face CLI (hf) on the host that downloads the weights: huggingface_hub at the version the install was
# tested with (wheel sha256 d76fa1d8e6a59e01f012b1d88da604c099c7a0f2e26b1cc7d708f0a4283bd2a2; Python 3.10 or newer).
# The host CLI and the container's wheels.lock are separate environments, so the versions differ.
# scripts/fetch-weights.sh refuses another version (INSTALL.md, "What you need").
HF_HUB_VERSION=2.1.1

# Drafter: DFlash2. CC BY-NC-ND 4.0, research and evaluation only (non-commercial). Fetched unmodified, never redistributed.
DRAFTER_REPO=incoai/GLM-5.3-Flash-DFlash2
DRAFTER_REV=bf582e4eacc1810f76656d1811693ff6c6737d2a

# Refusal-removed (abliterated) weights: the gated source (MIT plus its model card's use conditions,
# config/ablit-notice.txt), converted on your box by scripts/convert-ablit.sh with the converter in scripts/ablit/.
# The scripts refuse to download or convert them until the converter and the conversion id are pinned; an ablit third
# you already have can be checked and served.
ABLIT_SOURCE_REPO=orcarouter/GLM-5.3-Flash-Uncensored-MLX
ABLIT_SOURCE_REV=c02a5f6fa06f0aa444877b44d19fd5c96390329f
ABLIT_SOURCE_LICENSE=MIT
ABLIT_CONVERTER_SHA256=80fd61709a2da6bf6d4a4b52c4e53d532fce62e62058b64269b45f66807ae056
# The conversion's identity (IDENTITY.json and CONVERSION-ID in $DATA/ablit/work/converted). convert-ablit.sh refuses
# a conversion with any other id. Each ablit third's .complete marker names it, followed by the third's own
# MANIFEST.sha256, so a fresh third matches manifests/ablit/rank<R>.sha256 file for file.
ABLIT_CONVERSION_ID=a5f27a4d2f39d854efb95408d6cf7176013572a0899a652f04ae9f18e5ad5043

# Chat template: the base weights' chat_template.jinja plus a six-line reasoning-effort block (template/README.md).
TEMPLATE_SHA256=77c01ab2ea2013fb68161c8c0de6bf6c96c95b3e699e518554da384a695ab482
