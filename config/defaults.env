# Used when neither the command line nor cluster.env chooses. The draft policies, with and without the drafter,
# are tuned per weight variant in config/profiles/<weights>.env.
# Which weight variant a box serves by default: base or ablit (INSTALL.md, "Weight variants").
WEIGHTS_DEFAULT=base
# dflash2: the DFlash2 drafter, the measured default (CC BY-NC-ND 4.0, non-commercial).
# none: no drafter; the weights' own prediction head drafts, which avoids the drafter's license.
DRAFTER_DEFAULT=dflash2
# disk: the session tier keeps conversation state on this box's disk (measured). off: no conversation state on disk.
SESSION_TIER_DEFAULT=disk
# Containers are named <prefix>-rank<R>. Change CONTAINER_PREFIX in cluster.env if that name is taken on your boxes.
CONTAINER_PREFIX_DEFAULT=jspark3
