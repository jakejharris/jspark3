# Generated from the release candidate's measured boot record (all three ranks agree). Do not edit by hand:
# a change here is a different configuration from the one measured.
# Container environment, docker --env-file format. Per-box values (LAN and ring interfaces)
# come from cluster.env; see scripts/serve.sh.
# Per-variant settings (the draft policy and the engine knobs that differ by weights) are in
# config/profiles/<weights>.env.
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET
NCCL_MAX_NCHANNELS=8
NCCL_NET_PLUGIN=none
PYTHONUNBUFFERED=1
TENSORFOLD_NO_UPDATE_CHECK=1
TF_COMM_ONEHOP=1
TF_GLM_A2_ATTENTION_TILES=1
TF_GLM_A2_EXPRESS=1
TF_GLM_CACHE_GIB=5
TF_GLM_COFILL=1
TF_GLM_COFILL_BIG=0
TF_GLM_DECODE_OBSERVE_DIR=
TF_GLM_DISK_DIR=/sessions
TF_GLM_DISK_GIB=64
TF_GLM_DISK_MATH_VERSION=E:509bfa8
TF_GLM_EXACT_REPLAY=1
TF_GLM_EXPERT_PREFILL128=1
TF_GLM_EXPERT_PREFILL64=1
TF_GLM_EXPERT_WHOLE_PASS=1
TF_GLM_EXPRESS_ATOMIC_ROWS=512
TF_GLM_EXPRESS_BUSY_ROWS=32
TF_GLM_EXPRESS_COFILL=1
TF_GLM_EXPRESS_GATHER_MS=25
TF_GLM_FAIR_SCHED=1
TF_GLM_FOLLOWER_DOORBELL=1
TF_GLM_GROW_REPLIES=0
TF_GLM_KDA_VALUE_TILES=1
TF_GLM_L2_PREFETCH=1
TF_GLM_L2_PREFETCH_BYTES=4194304
TF_GLM_P1_DEAD_WORK=1
TF_GLM_P1_DENSE_ROWS=1
TF_GLM_P1_PROMPT_SCRATCH=1
TF_GLM_P1_SELECT_BLOCKS=1
TF_GLM_P1_VISIBLE_POOLS=1
TF_GLM_POOL_TOKENS=360448
TF_GLM_PREFILL_ROWS=4096
TF_GLM_PREFILL_ROWS_IDLE=8192
TF_GLM_PREFILL_SLICE_LAYERS=0
TF_GLM_PREFILL_SLICE_MS=60
TF_GLM_REPLY_PREFILL=1
TF_GLM_REPLY_PREFILL_ROWS=256
TF_GLM_SESSION_CANCEL=0
TF_GLM_SESSION_CHECKPOINTS=0
TF_GLM_SESSION_DISK=1
TF_GLM_SESSION_HASH_GATE=0
TF_GLM_SESSION_STAGE_MIB=1024
TF_GLM_SP=1
TF_GLM_SPARSE_TRIM=1
TF_GLM_SP_MIN_ROWS=256
TF_GLM_SP_OVERLAP=1
TF_GLM_SP_OVERLAP_MIN_ROWS=1024
TF_V2_PARITY=1
TORCH_CUDA_ARCH_LIST=12.1
TORCH_EXTENSIONS_DIR=/kernel-cache/torch_extensions
TRITON_CACHE_DIR=/kernel-cache/triton
