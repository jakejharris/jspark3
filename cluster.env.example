# Copy to cluster.env on every box and fill it in. One box per rank; rank 0 serves the API.
# Plain KEY=VALUE lines: scripts read this file both from bash and from Python.
DATA=/data/jspark3              # local NVMe directory owned by you; see INSTALL.md for the space each step needs
RANK=0                          # 0, 1 or 2 (different on each box)
MASTER_ADDR=192.0.2.10          # rank 0's LAN address (bootstrap only; tensors go over the cables)
MASTER_PORT=29561
LAN_IFACE=enP7s7                # the LAN interface every box shares
PREV_IFACE=enp1s0f0np0          # the ConnectX-7 port cabled to the previous rank (ring 0 -> 1 -> 2 -> 0)
NEXT_IFACE=enp1s0f1np1          # the ConnectX-7 port cabled to the next rank
API_PORT=8002                   # rank 0 only
API_HOST=127.0.0.1              # rank 0 only. Loopback: the API has no authentication. Reach it through an ssh tunnel or an authenticating proxy (INSTALL.md)
WEIGHTS=                        # base or ablit; empty uses config/defaults.env. Must be the same on all three boxes
DRAFTER=                        # dflash2 (CC BY-NC-ND 4.0 drafter) or none (no drafter); empty uses config/defaults.env. Same on all three boxes
SESSION_TIER=                   # disk (conversation state kept on this box's disk) or off (none kept on disk); empty uses config/defaults.env. Same on all three boxes
CONTAINER_PREFIX=                # containers are named <prefix>-rank<R>; empty uses jspark3. Set another if that name is taken
PREV_PEER=                      # optional: the previous rank's address on this box's PREV_IFACE cable (preflight pings it at MTU 9000)
NEXT_PEER=                      # optional: the next rank's address on this box's NEXT_IFACE cable
