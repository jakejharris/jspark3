+#!/usr/bin/env python3
+"""Resume the approved GitHub release without replacing conflicting public state."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import package as p
+from publish_checks import verify_local, verify_public_main, verify_redesign, verify_refs
+
+REPO = 'jakejharris/jspark3'
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def context(out, checkout, manifest, plan):
+    return {'out': out, 'checkout': checkout, 'manifest': manifest, 'plan': plan,
+            'body': (out / 'release-body.md').read_text(),
+            'assets': {name: (out / 'assets' / name).read_bytes() for name in p.files(out / 'assets')}}
+
+
+class GitHub:
+    def __init__(self, ctx):
+        self.ctx = ctx
+
+    def api(self, path, missing=False):
+        try:
+            return json.loads(p.run(['gh', 'api', 'repos/' + REPO + '/' + path]).stdout)
+        except subprocess.CalledProcessError as exc:
+            if missing and '(HTTP 404)' in (exc.stderr or ''):
+                return None
+            raise
+
+    def refs(self, complete=True):
+        plan = self.ctx['plan']
+        text = p.run(['git', '-C', self.ctx['checkout'], 'ls-remote', 'origin',
+                      'refs/heads/' + plan['branch'], 'refs/tags/' + plan['tag'],
+                      'refs/tags/' + plan['tag'] + '^{}']).stdout
+        return verify_refs(text, plan, complete)
+
+    def release(self):
+        # The tag lookup is for published releases. Authenticated release listing
+        # also exposes drafts, including a draft whose create acknowledgement was lost.
+        pages = json.loads(p.run(['gh', 'api', 'repos/' + REPO + '/releases', '--paginate', '--slurp']).stdout)
+        matches = [row for page in pages for row in page if row['tag_name'] == self.ctx['plan']['tag']]
+        p.need(len(matches) <= 1, 'multiple releases share the approved tag')
+        return matches[0] if matches else None
+
+    def before_create(self):
+        verify_public_main(self.ctx['manifest'], self.api('git/ref/heads/main'))
+        redesign = json.loads(p.run(['gh', 'pr', 'view', '98', '--repo', 'jakejharris/jakeportfolio',
+                                     '--json', 'state,mergedAt']).stdout)
+        verify_redesign(redesign)
+
+    def create(self):
+        ctx = self.ctx
+        p.need((ctx['out'] / 'release-body.md').read_text() == ctx['body'], 'local release notes changed')
+        p.run(['gh', 'release', 'create', ctx['plan']['tag'], '--draft', '--repo', REPO,
+               '--verify-tag', '--target', ctx['plan']['commit'], '--title', 'JSpark3 ' + ctx['plan']['tag'],
+               '--notes-file', ctx['out'] / 'release-body.md'])
+
+    def asset_bytes(self, asset):
+        return subprocess.run(['gh', 'api', 'repos/' + REPO + '/releases/assets/' + str(asset['id']),
+                               '-H', 'Accept: application/octet-stream'], check=True, capture_output=True).stdout
+
+    def remove_placeholder(self, asset):
+        p.run(['gh', 'api', '--method', 'DELETE', 'repos/' + REPO + '/releases/assets/' + str(asset['id'])])
+
+    def upload(self, name):
+        path = self.ctx['out'] / 'assets' / name
+        p.need(path.read_bytes() == self.ctx['assets'][name], 'local asset changed before upload')
+        p.run(['gh', 'release', 'upload', self.ctx['plan']['tag'], path, '--repo', REPO])
+
+    def publish(self):
+        p.run(['gh', 'release', 'edit', self.ctx['plan']['tag'], '--repo', REPO, '--draft=false', '--latest'])
+
+    def pr_state(self):
+        return json.loads(p.run(['gh', 'pr', 'view', '9', '--repo', REPO, '--json', 'state']).stdout)['state']
+
+    def close_pr(self):
+        p.run(['gh', 'pr', 'close', '9', '--repo', REPO])
+
+
+def check_release(release, ctx, github, partial=False):
+    p.need(release['tag_name'] == ctx['plan']['tag'] and release['name'] == 'JSpark3 ' + ctx['plan']['tag']
+           and release['target_commitish'] == ctx['plan']['commit'] and release['prerelease'] is False,
+           'existing release identity differs')
+    normalize = lambda text: text.replace('\r\n', '\n').rstrip('\n')
+    p.need(normalize(release['body'] or '') == normalize(ctx['body']), 'existing release notes differ')
+    rows = release['assets']
+    p.need(len(rows) == len({row['name'] for row in rows}), 'duplicate release asset names')
+    missing = set(ctx['assets'])
+    placeholders = []
+    for row in rows:
+        name = row['name']
+        p.need(name in missing, 'unexpected release asset')
+        # A failed draft upload may leave an empty GitHub starter placeholder.
+        if partial and release['draft'] and row['state'] == 'starter' and row['size'] == 0 and not row.get('digest'):
+            placeholders.append(row)
+            continue
+        data = ctx['assets'][name]
+        p.need(row['state'] == 'uploaded' and row['size'] == len(data), 'existing asset is incomplete or differs')
+        if row.get('digest'):
+            p.need(row['digest'] == 'sha256:' + digest(data), 'existing asset hash differs')
+        else:
+            p.need(github.asset_bytes(row) == data, 'existing asset bytes differ')
+        missing.remove(name)
+    p.need(partial or not missing, 'release assets are incomplete')
+    return sorted(missing), placeholders
+
+
+def reconcile(ctx, github):
+    github.refs()
+    existing = github.release()
+    if existing is not None:
+        check_release(existing, ctx, github, partial=True)
+    p.need(github.pr_state() in ('OPEN', 'CLOSED'), 'unexpected contributor PR state')
+    if existing is None:
+        github.before_create()
+        github.create()
+        existing = github.release()
+        p.need(existing is not None, 'release not visible after draft creation; rerun')
+    missing, placeholders = check_release(existing, ctx, github, partial=True)
+    for row in placeholders:
+        github.remove_placeholder(row)
+    for name in missing:
+        github.upload(name)
+    # Re-read every asset before publishing; no clobber, deletion of uploaded
+    # assets, or replacement of mismatched notes/ref objects is permitted.
+    github.refs()
+    complete = github.release()
+    check_release(complete, ctx, github)
+    if complete['draft']:
+        github.publish()
+    published = github.release()
+    check_release(published, ctx, github)
+    p.need(published['draft'] is False, 'release remains draft; rerun')
+    state = github.pr_state()
+    p.need(state in ('OPEN', 'CLOSED'), 'contributor PR state changed')
+    if state == 'OPEN':
+        github.close_pr()
+    p.need(github.pr_state() == 'CLOSED', 'PR close incomplete; rerun')
+    p.need(type(published['id']) is int and published['id'] > 0, 'invalid release identifier')
+    return {'release_id': published['id'], 'tag': ctx['plan']['tag'], 'status': 'PUBLISHED',
+            'package_sha256': p.sha(ctx['out'] / 'package.json')}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('package', type=Path)
+    parser.add_argument('--checkout', type=Path, required=True)
+    parser.add_argument('--go', type=Path, required=True)
+    parser.add_argument('--variants', type=Path)
+    args = parser.parse_args()
+    manifest, plan = verify_local(args.package, args.checkout, args.go, args.variants)
+    ctx = context(args.package, args.checkout, manifest, plan)
+    result = reconcile(ctx, GitHub(ctx))
+    p.save(args.package / 'publish-complete.json', result)
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == '__main__':
+    main()
