# Copy to .env and replace every placeholder. Values below are documentation only.
JSPARK_RANK0_HOST=rank0.example.invalid
JSPARK_RANK1_HOST=rank1.example.invalid
JSPARK_RANK2_HOST=rank2.example.invalid
JSPARK_RANK0_ADDR=198.51.100.10
JSPARK_RANK1_ADDR=198.51.100.11
JSPARK_RANK2_ADDR=198.51.100.12
JSPARK_MASTER_ADDR=198.51.100.10
JSPARK_FABRIC_IFACES_0=fabric0,fabric1
JSPARK_FABRIC_IFACES_1=fabric0,fabric1
JSPARK_FABRIC_IFACES_2=fabric0,fabric1
JSPARK_FABRIC_ADDRS_0=192.0.2.10/24,203.0.113.20/24
JSPARK_FABRIC_ADDRS_1=192.0.2.11/24,198.51.100.30/24
JSPARK_FABRIC_ADDRS_2=198.51.100.31/24,203.0.113.21/24
JSPARK_HCAS_0=roce0,roce1
JSPARK_HCAS_1=roce0,roce1
JSPARK_HCAS_2=roce0,roce1
JSPARK_SOCKET_IFNAME_0=mgmt0
JSPARK_SOCKET_IFNAME_1=mgmt0
JSPARK_SOCKET_IFNAME_2=mgmt0
# Verify one common RoCE-v2/IPv4 index on all six HCAs; this fleet observed 3.
JSPARK_IB_GID_INDEX=3
JSPARK_MODEL_ROOT=/srv/models
JSPARK_WORK_ROOT=/srv/jspark3
JSPARK_RECIPE_ROOT=/srv/jspark3-recipe
JSPARK_FLY_ROOT=/srv/sources/FlyCockpit-GLM-5.3-Flash-EXL3-3x-DGX-Sparks
JSPARK_MASTER_PORT=29533
JSPARK_API_BIND=0.0.0.0
JSPARK_API_PORT=8888

ABLIT=0

# Capacity selected by measured host-reserve admission.
JSPARK_GPU_MEMORY_UTILIZATION=0.76

# v1.6 decode options.  Production admits independent off/on arms; the
# negative-coarse FP8 sensitivity control is accepted only by the qa profile
# with JSPARK3_V16_DENSE_FP8_NEGATIVE_CONTROL=I_UNDERSTAND_TEST_ONLY.
JSPARK3_V16_PROFILE=production-stock
JSPARK3_V16_COOP=1
GLM53_ADAPTIVE_K=ema
JSPARK3_V16_DENSE_FP8=trunk

# v1.4 display-reserve KV profile: full (pool on) or display0 (pool off).
# Under full, name each rank's host DRM node (the /sys/class/drm/cardN whose
# driver is nvidia, resolved at preflight); display0 must not declare them.
JSPARK3_V14_PROFILE=full
JSPARK_DRM_CARD_0=/dev/dri/card0
JSPARK_DRM_CARD_1=/dev/dri/card0
JSPARK_DRM_CARD_2=/dev/dri/card0
JSPARK3_V16_APC_LRU=1
JSPARK3_TRIAR=1
JSPARK3_TRIAR_P2P=auto
